# Environment files — JANGAN commit secret/dev config
.env
.env.*
!.env.example

# SSH keys / secret lokal (jangan commit)
id_rsa*
*.pem
*.key

# Log & artifact lokal
*.log
*.test

# Binary hasil build lokal — pakai path spesifik (jangan basename,
# karena basename sama dgn nama direktori service sehingga ikut
# mengecualikan direktori tsb beserta .env.example di dalamnya)
services/ingestion-tcp/ingestion-tcp
services/ingestion-tcp/ingestion-tcp.test
services/worker-persistence/worker-persistence
services/service-websocket/service-websocket
services/worker-alert/worker-alert
services/api-vehicle/api-vehicle
services/worker-live/worker-live
services/service-media/service-media
cmd/migrate-tenant/migrate-tenant
cmd/db-replica-probe/db-replica-probe
cmd/querybench/querybench
cmd/partition-maintain/partition-maintain
database/tools/genhash/genhash
database/tools/genregions/genregions
tools/e2e-pub/e2e-pub
loadtest/loadtest