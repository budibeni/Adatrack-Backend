# Editor/IDE workspace files (machine-specific).
/.vscode/

# Compiled tool binaries (build with `go build`; never commit).
/tools/querybench/querybench


# Build artifacts
/bin/
/logs/
*.exe
*.test
*.out

# Compiled module binaries — `go build .` inside a module drops the binary next
# to its sources; canonical builds write to bin/ via `make build`. Never commit.
/services/foundation-check/foundation-check
/services/ingestion-tcp/ingestion-tcp
/services/worker-live/worker-live
/services/worker-persistence/worker-persistence
/tools/e2e/e2e
/tools/e2ews/e2ews
/tools/e2e-fleet/e2e-fleet

# Go
vendor/

# Local runtime data
*.log
tmp/
.pgdata/

# B4 backup/DR artifacts (dump + checksum are environment-specific; never commit).
/backups/

# Secrets: never commit credentials (§9.5). `.env.local` (dev defaults) and
# `.env.coolify` (production placeholders) are NOT tracked: copy the tracked
# template `.env.example` and fill in values per variant (§7 — no mixed config).
.env.local
.env.coolify
.env.coolify.local
.env.*.secret
*.pem
*.key
# Prometheus file_sd hasil generate — isinya machine-specific (alamat host yang
# bisa dijangkau container Prometheus). Diregenerasi otomatis oleh
# `make up` / `make monitoring-up` / `make prom-targets`; lihat
# scripts/gen-prom-targets.sh.
/monitoring/targets/*.json
