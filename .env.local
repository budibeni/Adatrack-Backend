DB_USER=adatrack_gps_user
DB_PASSWORD=adatrack_gps_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adatrack_gps_master
DB_MAX_CONNS=50
DB_MIN_CONNS=5

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

NATS_URL=nats://localhost:4222

# GPS Ingestion Ports (Avoid standard 9000s)
PORT_GT06=15000
PORT_TELTONIKA=15001
PORT_COBAN=15002
PORT_MEITRACK=15003
PORT_H02=15004

# S3 / MinIO Configuration
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=adatrack-media
S3_REGION=us-east-1
S3_USE_SSL=false

# API & Security
PORT_WEBSOCKET=8080
JWT_SECRET=jwt@ajb2026gps

# NATS JetStream Config
JETSTREAM_MAX_AGE_HOURS=48
JETSTREAM_MAX_BYTES=4294967296
