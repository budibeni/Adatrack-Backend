# ============================================================================
# ADATRACK backend — environment reference (PRD §7.2)
# ============================================================================
# Copy/derive the concrete variants:
#   LOCAL   : .env.local    (dev/staging machine)
#   COOLIFY : .env.coolify  (production; secrets come from Coolify resources)
# Selected by scripts/compose-up.sh via COMPOSE_VARIANT.
# NEVER store production secrets in .env.local and vice versa (§7).
# ============================================================================

# --- Variant selector + shared -------------------------------------------------
COMPOSE_VARIANT=local
LOG_LEVEL=info
TELEMETRY_INTERVAL_SECONDS=20

# --- PostgreSQL (§7.1, schema-per-tenant) -------------------------------------
# One physical DB, many schemas: adatrack_gps_master + adatrack_gps_{company}.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=adatrack_gps_db
POSTGRES_USER=adatrack
POSTGRES_PASSWORD=change-me
# Optional single-URL override (highest priority; per-tenant search_path is
# always forced on top of it — never rely on it to select a tenant).
DATABASE_URL=
POSTGRES_POOL_MIN=20
POSTGRES_POOL_MAX=50
# --- Read replica / read/write split (B4, PRD §13) ---------------------------
# Optional standby for READ-ONLY queries. EMPTY HOST = split disabled: every read
# uses the primary, i.e. exactly the pre-B4 behaviour. Credentials and database
# default to the primary's, so normally only HOST (+PORT) must be set — the LOCAL
# HA overlay provides one:
#   make ha-up                                     # postgres-replica on 127.0.0.1:5433
#   POSTGRES_REPLICA_HOST=127.0.0.1 POSTGRES_REPLICA_PORT=5433
# Verified by `make replica-drill` and by the tenant IT suite:
#   ADATRACK_IT=1 ADATRACK_IT_PG_REPLICA=127.0.0.1:5433 go test ./internal/tenant/
POSTGRES_REPLICA_HOST=
POSTGRES_REPLICA_PORT=5433
POSTGRES_REPLICA_USER=
POSTGRES_REPLICA_PASSWORD=
POSTGRES_REPLICA_DB=
# Master schema + per-company schema prefix (PRD §6).
MASTER_DB_NAME=adatrack_gps_master
COMPANY_DB_PREFIX=adatrack_gps_
# Company migration artifacts (§14.5).
COMPANY_MIGRATIONS_DIR=./database/migrations/company_pg
MASTER_MIGRATIONS_DIR=./database/migrations/master_pg

# --- Redis (§7.2) -------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=adatrack_gps:
REDIS_TTL_SEC=300
REDIS_POOL_MIN=10
REDIS_POOL_MAX=30
REDIS_MAXMEMORY=512mb

# --- NATS / JetStream (§7.2, §7.6) -------------------------------------------
NATS_URL=nats://nats:4222
NATS_SUBJECT_PREFIX=telemetry
JETSTREAM_MAX_AGE_HOURS=48
JETSTREAM_MAX_BYTES=4294967296
NATS_MAX_PAYLOAD=1048576

# --- ingestion-tcp (§7.2) -----------------------------------------------------
TCP_PORT=9003
TCP_MAX_CONNECTIONS=5000
TELTONIKA_TCP_PORT=9011
# --- B9 protocol expansion (PRD Module 1c) --------------------------------
# One listener per device family; empty/"0" disables that family. The boot guard
# refuses two protocols sharing a port. Dev defaults below keep every extra
# listener ON (dedicated dev ports, no clash with TCP_PORT/TELTONIKA_TCP_PORT), so
# the protocol-expansion E2E can exercise them; production uses the Traccar ports
# (see .env.coolify).
TK103_TCP_PORT=9013
MEILIGAO_TCP_PORT=9002
XEXUN_TCP_PORT=9004
SUNTECH_TCP_PORT=9017
H02_TCP_PORT=9010
TOTEM_TCP_PORT=9005
GT02_TCP_PORT=9006
NAVIGIL_TCP_PORT=9012
CASTEL_TCP_PORT=9019
# Strict checksum validation of the B9 decoder families (XOR/CRC per family).
# Set false only while onboarding a device whose vendor doc disagrees on the range.
INGESTION_CHECKSUM_STRICT=true
# GT06 server→device online command framing (B8): the vendor §8.1 example counts
# the 2 CRC bytes in Length, the verified client→server framing does not.
GT06_COMMAND_LENGTH_INCLUDES_CRC=false
# Castel (B9) server response: the reference writes the type field big-endian into a
# little-endian buffer while reading the device side as little-endian. Default false
# = the order this ingestion service reads. Flip only if a device rejects our reply.
CASTEL_RESPONSE_TYPE_BE=false
# Castel position payload (MSG_SC_GPS 0x4001). The field order and scales are
# verified upstream (lat/lon /3600000, speed cm/s, course /10), but the FLAG BITS
# differ between the 2015 and the modern source, so decoding is opt-in:
#   off (default) = frames counted as unsupported
#   on            = decode, bit0 = latitude sign / bit1 = longitude sign (2015)
#   on-swapped    = decode, bit1 = latitude sign / bit0 = longitude sign
# Confirm with ONE real frame (a mirrored position is visible immediately).
CASTEL_GPS_DECODE=off
# Navigil (B9) identifies devices by a 4-byte device id while the anti-spoofing
# allowlist (FR-1.4) is IMEI-based, so the mapping is explicit:
#   NAVIGIL_DEVICE_MAP=1234567=864201040512345,7654321=864201040512999
# An unmapped id is counted (ingestion_unmapped_devices_total) and logged, never
# silently trusted.
NAVIGIL_DEVICE_MAP=
# --- B10 telemetry cadence (FR-1.2) ---------------------------------------
# Nominal device reporting interval; exported as telemetry_interval_seconds and
# pushed to devices that support the downlink interval command (B8 TIMER).
TELEMETRY_INTERVAL_SECONDS=20
# --- B8 downlink commands (PRD §21.2 row 1) --------------------------------
# How long a `sent` command waits for the device's online-command reply.
COMMAND_ACK_TIMEOUT_SECONDS=30
COMMAND_SWEEP_SECONDS=5
# A command older than this is recorded as failed instead of being sent to a device.
# It bounds JetStream redelivery: a recreated durable consumer replays the stream,
# and an hours-old `engine_cut` must never be re-executed on a moving vehicle.
COMMAND_MAX_AGE_SECONDS=300
# --- B8 driver behaviour + maintenance (PRD §21.2 rows 4-5) ---------------
DRIVER_SPEEDING_MIN_SECONDS=10
# Minimum travelled distance for normalising the daily driver score per 100 km.
# Below it (or without B7.2 trips) the documented count-based score is used.
DRIVER_SCORE_MIN_DISTANCE_KM=5
MAINTENANCE_SWEEP_SECONDS=300
MAINTENANCE_REMINDER_COOLDOWN_HOURS=24
GT06_DATE_BCD=false
INGESTION_METRICS_ADDR=:8090

# --- worker-live --------------------------------------------------------------
LIVE_METRICS_ADDR=:8091
LIVE_BATCH_INTERVAL_MS=100

# --- worker-persistence -------------------------------------------------------
PERSISTENCE_METRICS_ADDR=:8092
BATCH_SIZE=500
BATCH_TIMEOUT_SEC=5
RETRY_MAX=3
RETRY_BACKOFF_MS=1000,5000,10000

# --- worker-alert (B3) ----------------------------------------------------------
# Alarm engine (PRD §5.9): consumes telemetry.raw.>, evaluates geofence / speed
# / battery / offline / SOS / route-deviation rules and publishes alerts.
ALERT_METRICS_ADDR=:8094
# Dedup: one OPEN alert per identity within this window (worker keeps the map).
ALERT_DEDUP_WINDOW_SEC=300

# --- api-vehicle (B3) -----------------------------------------------------------
# Fleet management REST listener (PRD §8.2). Shares the JWT_SECRET + denylist
# with service-websocket (PRD §9.1: the SAME claims must work for both).
API_VEHICLE_HTTP_ADDR=:8081

# --- service-websocket (B2) ---------------------------------------------------
# REST + WebSocket listener. PRD §14.2: HTTP 8082 serves /healthz + /metrics too.
HTTP_ADDR=:8082
# JWT (PRD §9.1): HS256. JWT_SECRET is REQUIRED (>= 32 chars) — the service
# refuses to boot with an implicit key. Rotate in production (secrets manager).
JWT_SECRET=dev-local-jwt-secret-change-me-32chars
JWT_ISSUER=adatrack
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_HOURS=168
JWT_REVOCATION_ENABLED=true
JWT_CLOCK_SKEW_SEC=30
AUTH_REFRESH_PREFIX=adatrack_gps:auth:refresh:
AUTH_DENYLIST_PREFIX=adatrack_gps:auth:denylist:
BCRYPT_COST=12
# Login protection (PRD §8.4/§9.1): 5 attempts / 15 min + lockout.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SEC=900
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
# API protection (PRD §8.4): 100 requests / minute / user.
API_RATE_LIMIT=100
API_RATE_WINDOW_SEC=60
# Pagination + validation bounds (PRD §8.5).
API_DEFAULT_PAGE_SIZE=100
API_MAX_PAGE_SIZE=1000
HISTORY_MAX_RANGE_DAYS=90
API_MAX_BODY_BYTES=1048576
# WebSocket (FR-5.3/FR-5.4).
WS_MAX_CONNECTIONS=5000
WS_SEND_BUFFER_BYTES=262144
WS_MAX_QUEUE=1000
WS_PING_INTERVAL_SEC=30
WS_WRITE_TIMEOUT_SEC=10
WS_PONG_TIMEOUT_SEC=60
WS_MAX_MESSAGE_BYTES=4096
WS_MAX_SUBSCRIPTIONS=5000
# Browser origins allowed to open a WebSocket / CORS (comma separated).
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WS_ALLOW_EMPTY_ORIGIN=true
# Auto-provisioned tenant admin (FR-5.5) + its e-mail domain.
TENANT_ADMIN_EMAIL_DOMAIN=local
# Audit trail writer (PRD §9.4).
AUDIT_ENABLED=true
AUDIT_QUEUE_SIZE=1000
AUDIT_BATCH_SIZE=100
AUDIT_FLUSH_MS=1000

# --- worker-alert (B3) --------------------------------------------------------
OFFLINE_AFTER_MINUTES=3

# --- Migrations / governance (§7.8) ------------------------------------------
MIGRATE_ON_BOOT=true
MIGRATE_LOCK_TIMEOUT_SEC=60
MIGRATION_LEDGER_TABLE=tm_schema_migrations
COOLIFY_PREDEPLOY_MIGRATE=false
AUDIT_ENABLED=true
SOFT_DELETE_RETENTION_DAYS=180
PASSWORD_DEFAULT_TENANT_ADMIN=Admin@123

# --- Host bind ports (LOCAL only) --------------------------------------------
HOST_PG_PORT=5533
HOST_REDIS_PORT=6380
HOST_NATS_PORT=4222
HOST_NATS_MONITOR_PORT=8222

# --- Object storage / MinIO (B5b dashcam event media, PRD Module 8 / FR-8.1) ---
# LOCAL   : docker-compose.local.yml defines the `minio` service; the media
#           bucket/object lifecycle is exercised locally on the loopback ports
#           below, so there is no profile gate.
# COOLIFY : deployments/docker-compose.coolify.yml also ships its own `minio` +
#           `minio-init` (bucket auto-created, idempotent) as a TEMPORARY
#           object storage so the deploy stays one click. There
#           MEDIA_S3_ENDPOINT is the internal service URL (http://minio:9000),
#           NOT the loopback one below.
# Swapping to another cloud later means only changing MEDIA_S3_* (and
# MEDIA_BACKEND when it is not S3) and deleting minio/minio-init + miniodata —
# no application code changes, since all access goes through internal/storage.
HOST_MINIO_PORT=9000
HOST_MINIO_CONSOLE_PORT=9001
# Consumed by service-media (and the MinIO root user above).
# LOCAL uses the MinIO defaults; production MUST inject real secrets (§7).
MEDIA_BACKEND=s3
MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
MEDIA_S3_ACCESS_KEY=minioadmin
MEDIA_S3_SECRET_KEY=change-me
MEDIA_S3_BUCKET=adatrack-media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_USE_SSL=false
# Signed-URL secret + listeners used by service-media (B5b).
MEDIA_HMAC_SECRET=change-me
MEDIA_HTTP_ADDR=:8095
MEDIA_METRICS_ADDR=:8096
# Retensi media (FR-8.7, service-media): jadwal cron sweep + TTL unggahan JSON
# yang tidak pernah di-complete. MEDIA_RETENTION_SWEEP_SEC hanya untuk dev/E2E
# (interval detik, menimpa cron).
MEDIA_RETENTION_DAYS=30
MEDIA_CLEANUP_CRON="0 3 * * *"
MEDIA_PENDING_TTL_HOURS=24
MEDIA_HMAC_MAX_SKEW_SEC=300
# Kalibrasi sensor BBM GT06 (B5a FR-7.3/FR-7.8): cm tinggi tangki, 0 = nonaktif.
FUEL_TANK_HEIGHT_CM=0
# Rate limit tier ingest HMAC service-media (per IP; 0 = matikan).
MEDIA_INGEST_RATE_LIMIT=600
MEDIA_INGEST_RATE_WINDOW_SEC=60

# --- Fleet Management Core (B7.1/B7.2, PRD FR-2.5/FR-2.6) ---------------------
# Akumulator odometer/engine-hours + state machine trip/stop di worker-live.
# Nilai default = nilai PRD; semuanya bisa ditimpa tanpa perubahan kode.
FLEET_FLUSH_SECONDS=30          # flush delta akumulator ke tm_vehicles (FR-2.5)
FLEET_FLUSH_BATCH=100           # flush lebih awal bila ≥N vehicle pending
ODOMETER_MAX_JUMP_KM=5          # buang delta jarak > 5 km sebagai GPS jump
ODOMETER_MAX_GAP_SECONDS=300    # interval device > ini tidak dikreditkan
ENGINE_HOURS_MAX_GAP_SECONDS=300
TRIP_STOP_GRACE_SECONDS=30      # lama diam sebelum stop dikonfirmasi
TRIP_MIN_STOP_SECONDS=60        # stop lebih pendek = blip (tidak memecah trip)
TRIP_MAX_STOP_SECONDS=3600      # auto-close trip setelah diam/senyap selama ini
TRIP_MOVING_SPEED_KMH=0         # ambang MOVING (0 = speed > 0, FR-2.2)

# --- History playback & reverse geocoding (B7.3/B7.4) -------------------------
PLAYBACK_MAX_POINTS=20000       # batas titik per respons playback (truncated=true bila lewat)
PLAYBACK_TOLERANCE_M=10         # toleransi RDP default (0 = tanpa reduksi)
PLAYBACK_MAX_TOLERANCE_M=1000   # batas nilai `tolerance_m` dari klien
GEOCODE_INDEX_REFRESH_SEC=21600 # reload indeks wilayah master (6 jam)
GEOCODE_CACHE_TTL_SEC=21600     # TTL cache Redis/in-memory hasil reverse geocode
GEOCODE_MAX_DISTANCE_KM=75      # radius pencarian fallback (level provinsi)
GEOCODE_SPECIFIC_MAX_KM=30      # radius "level spesifik" (kota/kecamatan/desa)
GEOCODE_MAX_POINTS=500          # titik playback yang di-geocode (endpoint selalu)

# --- Monitoring stack (B4, PRD §10.4) -----------------------------------------
# Prometheus/Alertmanager/Grafana + node/cAdvisor/postgres/redis exporters are
# part of the SINGLE stack (docker-compose.yml) — there is no separate monitoring
# compose file. LOCAL re-binds every port below to 127.0.0.1 via
# docker-compose.local.yml; the Coolify variant only `expose`s them internally
# and requires GRAFANA_ADMIN_PASSWORD as a real Coolify secret (§7).
PROM_RETENTION=15d
HOST_PROM_PORT=9095
HOST_ALERTMANAGER_PORT=9093
HOST_GRAFANA_PORT=3001
HOST_NODE_EXPORTER_PORT=9100
HOST_CADVISOR_PORT=8084
HOST_PG_EXPORTER_PORT=9187
HOST_REDIS_EXPORTER_PORT=9121
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Backup / DR (B4, PRD §12) ------------------------------------------------
# scripts/backup-db.sh | restore-db.sh | backup-redis.sh | retention-purge.sh
BACKUP_RETENTION_DAYS=14
HOT_RETENTION_DAYS=30
# Endurance runner (scripts/b4-verify.sh step 4): 6 chunks x 600s = 1h sample.
# Full acceptance (24h) = B4_ENDURANCE_CHUNKS=24 B4_ENDURANCE_CHUNK_SEC=3600.
B4_ENDURANCE_CHUNKS=6
B4_ENDURANCE_CHUNK_SEC=600