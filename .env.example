# ============================================================================
# EXAMPLE ENV — backend/.env.example
#
# Salin ke backend/.env lalu isi nilai sesuai environment Anda:
#   cp backend/.env.example backend/.env
#
# Ini adalah file SAMPEL (nilai placeholder) untuk MENUJU setup. Nilai NYATA
# untuk dev lokal ada di backend/.env (single source of truth — SEGALA service
# memakai file ini; tidak ada .env per-service). JANGAN commit backend/.env yang
# berisi secret; gunakan file ini sebagai template dan isi secret via env proses
# atau secrets manager (PRD §7 / GAP #5).
# ============================================================================

# --- Kontrol loader ---
# adatrack_ENV=development          # opsional; loader juga membaca backend/.env.development
# ENV_FILE=/abs/path/.env        # opsional; paksa file env lain

# --- Provider database persistent (PRD §7.1.1): postgres (default) | mysql ---
DATABASE_PROVIDER=postgres

# Kopel docker-compose (HARUS sama dengan DATABASE_PROVIDER; hanya DB terpilih
# dan turunannya yang ikut up). backend/scripts/compose-up.sh mengisi ini
# otomatis dari DATABASE_PROVIDER.
COMPOSE_PROFILES=postgres

# --- NATS ---
NATS_URL=127.0.0.1:4222
NATS_CLUSTER_ID=
NATS_CLIENT_ID=
# NATS_SUBJECT_PREFIX: namespace telemetry.* (default "telemetry").
# alert.* / notify.* TIDAK di-prefix (konvensi PRD §subjects).
NATS_SUBJECT_PREFIX=telemetry

# --- MySQL app (docker MySQL di host :3307; 3306 dipakai host-native di dev) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=adatrack_gps_user
MYSQL_ROOT_PASSWORD=<ganti-password-root>
MYSQL_PASSWORD=<ganti-password-mysql>
MYSQL_DB=adatrack_gps_db
MYSQL_MAX_OPEN_CONNS=50
MYSQL_MAX_IDLE_CONNS=20
MYSQL_CONN_MAX_LIFETIME=30

# --- Multi-tenant (PRD §6/§7): master + pool company DB ---
MASTER_DB_HOST=127.0.0.1
MASTER_DB_PORT=3307
MASTER_DB_USER=adatrack_gps_user
MASTER_DB_PASSWORD=<ganti-password-master>
MASTER_DB_NAME=adatrack_gps_master
COMPANY_DB_PREFIX=adatrack_gps_
MYSQL_POOL_MIN=10
MYSQL_POOL_MAX=50

# --- PostgreSQL ---
# Konfigurasi database PostgreSQL (dev lokal via docker). Lihat komentar penuh
# di backend/.env, termasuk catatan soal ROOT_PASSWORD vs superuser image resmi.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=adatrack_gps_db
POSTGRES_USER=adatrack_gps_user
POSTGRES_PASSWORD=<ganti-password-postgres>
POSTGRES_ROOT_PASSWORD=<ganti-password-postgres-root>
PGDATA=/var/lib/postgresql/data
POSTGRES_SSLMODE=disable
POSTGRES_POOL_MIN=10
POSTGRES_POOL_MAX=50

# --- Replikasi PostgreSQL streaming (overlay deployments/docker-compose.ha.yml) ---
POSTGRES_REPLICA_PORT=5433
POSTGRES_REPLICA_USER=replicator
POSTGRES_REPLICA_PASSWORD=<ganti-password-replikasi>
# DSN siap pakai; ganti <ganti-password-postgres-url-encoded> dg password
# yang sudah di-URL-encode (@ -> %40), mis. user%40123
DATABASE_URL=postgres://adatrack_gps_user:<ganti-password-postgres-url-encoded>@127.0.0.1:5432/adatrack_gps_db?sslmode=disable

# --- Read/write split APP-LEVEL (B4 HA): READ → REPLICA, WRITE → PRIMARY ---
# Query SELECT service diarahkan ke replika; INSERT/UPDATE/DELETE selalu ke
# primary. Aktifkan HANYA saat replika dari docker-compose.ha.yml ikut up —
# bila tidak, biarkan false (semua baca otomatis ke primary).
DB_REPLICA_ENABLED=false
DB_REPLICA_POOL_MIN=5
DB_REPLICA_POOL_MAX=50
DB_REPLICA_PROBE_SECONDS=10
# MYSQL_REPLICA_PORT=3407   # dipakai saat DATABASE_PROVIDER=mysql

# --- Redis (docker di :6390 di dev; sesuaikan di target) ---
REDIS_ADDR=127.0.0.1:6390
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_KEY_PREFIX=adatrack_gps:          # berakhiran ':' agar key = adatrack_gps:{company_code}:vehicle:state:<IMEI>

# --- JWT (WAJIB sama antara service-websocket & api-vehicle agar token valid) ---
JWT_SECRET=<ganti-jwt-secret-yang-kuat>
JWT_EXPIRY_HOURS=24

# --- Alert / geofence / SOS (worker-alert) ---
SPEED_LIMIT=80
SPEED_GRACE_MARGIN=10
SOS_ESCALATION_MINUTES=2
SOS_ESCALATION_MAX=3

# --- Rate limit (GAP #12) ---
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_API_PER_MIN=100

# --- WebSocket (service-websocket, FR-5.x) ---
WS_READ_BUFFER=4096
WS_WRITE_BUFFER=4096
WS_PONG_WAIT=30
WS_WRITE_WAIT=10
WS_MAX_MESSAGE_SIZE=262144
WS_MAX_CONNECTIONS=5000
WS_MAX_QUEUE=1000
WS_HEARTBEAT_SECONDS=30

# --- TCP ingestion (FR-1.x) ---
# GT06/Concox listener (wajib).
TCP_PORT=9000
TCP_MAX_CONNECTIONS=5000
# Listener per-protokol tambahan; "0" = nonaktif.
# Teltonika (Codec 8/8E) & TK-103 (provisional) masing-masing port sendiri.
TELTONIKA_TCP_PORT=9001
TK103_TCP_PORT=9002
# GT06 hari/tanggal encoding: docs Concox memakai "plain-hex" (nilai byte == digit
# desimal, mis. 0x17 = 23); beberapa firmware memakai BCD (0x17 = 17).
# Set true bila device Anda memakai BCD. Default false (sesuai docs).
GT06_DATE_BCD=false

# --- HTTP timing (service-websocket & api-vehicle) ---
HTTP_READ_TIMEOUT=15
HTTP_WRITE_TIMEOUT=30
CORS_ALLOWED_ORIGINS=*

# --- Bind address per-service (key UNIK; port bisa disesuaikan) ---
INGESTION_METRICS_ADDR=:8090
PERSISTENCE_METRICS_ADDR=:8091
LIVE_METRICS_ADDR=:8092
ALERT_METRICS_ADDR=:8093
WEBSOCKET_HTTP_ADDR=:8080
WEBSOCKET_METRICS_ADDR=:9090
API_VEHICLE_HTTP_ADDR=:8081

# --- TLS (produksi HTTPS/WSS; default off di dev) ---
TLS_ENABLED=false
TLS_CERT_FILE=certs/dev.crt
TLS_KEY_FILE=certs/dev.key

# --- Logging (structured JSON; debug|info|warn|error) ---
LOG_LEVEL=info

# --- Fuel sensor ---
FUEL_DROP_THRESHOLD=10
FUEL_REFUEL_THRESHOLD=10
FUEL_WINDOW_SECONDS=300
TELTONIKA_IO_FUEL_LEVEL=86
TELTONIKA_IO_FUEL_USED=87
TELTONIKA_IO_FUEL_TEMP=84
