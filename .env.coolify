DB_USER=adatrack_gps_user
DB_PASSWORD=adatrack_gps_password!
DB_HOST=postgres
DB_PORT=5432
DB_NAME=adatrack_gps_master
DB_MAX_CONNS=500
DB_MIN_CONNS=50

REDIS_ADDR=redis:6379
REDIS_PASSWORD=SuperSecretRedisPassword123!

NATS_URL=nats://nats:4222

# GPS Ingestion Ports
PORT_GT06=15000
PORT_TELTONIKA=15001
PORT_COBAN=15002
PORT_MEITRACK=15003
PORT_H02=15004

# S3 / MinIO Storage Configuration
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=adatrack-media
S3_REGION=us-east-1
S3_USE_SSL=false

# API & Security
PORT_WEBSOCKET=8080
JWT_SECRET=super-secret-prod-key-change-me

# NATS JetStream Config
JETSTREAM_MAX_AGE_HOURS=72
JETSTREAM_MAX_BYTES=10737418240
