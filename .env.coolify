DB_USER=adatrack_gps_user
DB_PASSWORD=adatrack_gps_password!
DB_HOST=postgres_db
DB_PORT=5432
DB_NAME=adatrack_gps_master
DB_MAX_CONNS=25
DB_MIN_CONNS=2

REDIS_ADDR=redis:6379
REDIS_PASSWORD=redis@adatrack2026@secret

NATS_URL=nats://nats:4222

# GPS Ingestion Ports
PORT_GT06=15000
PORT_TELTONIKA=15001
PORT_COBAN=15002
PORT_MEITRACK=15003
PORT_H02=15004

# S3 / MinIO Storage Configuration
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=adatrack-media
S3_REGION=us-east-1
S3_USE_SSL=false

# API & Security
PORT_WEBSOCKET=8080
JWT_SECRET=jwt@adatrack2026@secret

# NATS JetStream Config
JETSTREAM_MAX_AGE_HOURS=72
JETSTREAM_MAX_BYTES=10737418240

PORT_MEILIGAO_TCP=5002
PORT_XEXUN_TCP=5003
PORT_SUNTECH_TCP=5017
PORT_TOTEM_TCP=5005
PORT_GT02_TCP=5006
PORT_NAVIGIL_TCP=5012
PORT_CASTEL_TCP=5019
