# ============================================================================
# ADATRACK backend — COOLIFY variant (PRODUCTION) — PRD §7 / §14.1 / §14.5
# ============================================================================
# ️  NO DEV SECRETS HERE. Every credential below is a placeholder; the real
# values live in Coolify resources / secrets manager (§9.5) and are injected at
# deploy time. `deployments/docker-compose.coolify.yml` uses ${VAR:?...} so a
# missing secret ABORTS the deploy instead of silently falling back to dev.
#
# NEVER load this file together with .env.local (§7 "no mixed config").
# ============================================================================
COMPOSE_VARIANT=coolify
LOG_LEVEL=info
TELEMETRY_INTERVAL_SECONDS=20
IMAGE_TAG=latest

# --- PostgreSQL (Coolify-managed resource) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=adatrack_gps_db
POSTGRES_USER=adatrack
POSTGRES_PASSWORD=__REPLACE_WITH_COOLIFY_SECRET__
DATABASE_URL=
POSTGRES_POOL_MIN=20
POSTGRES_POOL_MAX=50
MASTER_DB_NAME=adatrack_gps_master
COMPANY_DB_PREFIX=adatrack_gps_
COMPANY_MIGRATIONS_DIR=./database/migrations/company_pg
MASTER_MIGRATIONS_DIR=./database/migrations/master_pg

# --- Redis (Coolify-managed resource) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__REPLACE_WITH_COOLIFY_SECRET__
REDIS_DB=0
REDIS_KEY_PREFIX=adatrack_gps:
REDIS_TTL_SEC=300
REDIS_POOL_MIN=10
REDIS_POOL_MAX=30
REDIS_MAXMEMORY=1gb

# --- NATS / JetStream ---
NATS_URL=nats://nats:4222
NATS_SUBJECT_PREFIX=telemetry
JETSTREAM_MAX_AGE_HOURS=48
JETSTREAM_MAX_BYTES=4294967296
NATS_MAX_PAYLOAD=1048576

# --- ingestion-tcp (GT06 canonical port 5001; Teltonika own reference 5027) ---
TCP_PORT=5001
TCP_MAX_CONNECTIONS=5000
TELTONIKA_TCP_PORT=5027
GT06_DATE_BCD=false
INGESTION_METRICS_ADDR=:8090

# --- worker-live ---
LIVE_METRICS_ADDR=:8091
LIVE_BATCH_INTERVAL_MS=100

# --- worker-persistence ---
PERSISTENCE_METRICS_ADDR=:8092
BATCH_SIZE=500
BATCH_TIMEOUT_SEC=5
RETRY_MAX=3
RETRY_BACKOFF_MS=1000,5000,10000

# --- worker-alert (B3) ---
OFFLINE_AFTER_MINUTES=3

# --- Migrations / governance (§14.5) ---
MIGRATE_ON_BOOT=true
MIGRATE_LOCK_TIMEOUT_SEC=60
MIGRATION_LEDGER_TABLE=tm_schema_migrations
COOLIFY_PREDEPLOY_MIGRATE=true
AUDIT_ENABLED=true
SOFT_DELETE_RETENTION_DAYS=180
PASSWORD_DEFAULT_TENANT_ADMIN=Admin@123